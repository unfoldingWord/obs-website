---
import Base from '../../layouts/Base.astro';
---
<Base title="Discover — Open Bible Stories" description="Read Open Bible Stories in your language, by any published team." active="discover">

<section class="page-header" style="padding:44px 0 32px;">
  <div class="wrap">
    <div class="discover-hero-intro">
      <p class="eyebrow">Find the Gospel in your language</p>
      <h1 style="margin:8px 0 14px;">Discover</h1>
      <p style="max-width:520px;">Search for Open Bible Stories in your language. Read, listen, watch, or download available translations.</p>

      <!-- MOBILE APP: a simple outline button, same style as the third CTA
           in the Home page hero, instead of a boxed card further down. -->
      <a href="https://play.google.com/store/apps/details?id=com.unfoldingword.obsapp&hl=en_US" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top:20px;">OBS Mobile App</a>

      <!-- Placed last in the DOM on purpose: it's position:absolute on desktop
           (so DOM order doesn't affect the layered look there), but on mobile
           it drops to position:relative and flows in normal document order —
           being last means it renders below the intro text instead of above
           it, which reads better than a map appearing before the heading. -->
      <img src="/assets/img/world-map-backdrop.svg" alt="" aria-hidden="true" class="discover-map-backdrop">
    </div>

    <div id="lang-browse" style="margin-top:60px;">
      <div class="library-tools">
        <div class="search-box">
          <span aria-hidden="true">&#128269;</span>
          <input id="lang-search" type="text" placeholder="Search by language name, e.g. Swahili">
        </div>
        <div class="format-filters">
          <button type="button" class="filter-chip active" data-format="all">All</button>
          <button type="button" class="filter-chip" data-format="pdf">Print</button>
          <button type="button" class="filter-chip" data-format="audio">Audio</button>
          <button type="button" class="filter-chip" data-format="video">Video</button>
        </div>
      </div>
      <p id="lib-status" class="lib-status"></p>
      <div id="lang-list" class="lang-list"></div>
    </div>

    <div id="lang-detail" hidden style="max-width:820px; margin:28px auto 0;"></div>
  </div>
</section>


<Fragment slot="scripts">
<script is:inline src="/assets/js/discover.js"></script>
</Fragment>
</Base>
