---
// Language hub: one static page per published OBS translation, generated from
// the build-time catalog snapshot (src/data/catalog.ts). This is the public
// canonical URL for "Open Bible Stories in {language}" (#6): everything a
// crawler or answer engine needs is in the initial HTML — autonym, English
// and alternate names, codes, region, formats that actually exist, the story
// titles that were actually read from the repo (usually all 50), an
// in-language extract of story 1, the publishers, and CC BY-SA attribution.
//
// Order is for the human reader first: name → actions (read / listen / watch /
// download) → a taste of the text → the story list → the catalog facts
// (codes, region, publishers) and license at the foot. Crawlers get the same
// facts wherever they sit.
//
// The page chrome (nav, footer, labels) uses the marketing locale whose
// primary subtag matches the content language, otherwise English; the
// <html lang>/dir and the font pack follow the CONTENT language.
import Base from '../../../layouts/Base.astro';
import { content } from '../../../i18n/content';
import { byCode, localePath } from '../../../i18n/config';
import {
  STORY_COUNT,
  languages,
  languagePath,
  storyPath,
  hubLocaleFor,
  fontHrefForScript,
  classifyAssets,
  readableStories,
  pagedStories,
  publishersOf,
  youtubeOf,
  primaryPdf,
  audioZipOf,
  formatSize,
  displayName,
  storyImage,
  type CatalogLanguage,
} from '../../../data/catalog';
import { hubNodes, LICENSE_URL } from '../../../lib/jsonld';
import { storiesFor } from '../../../data/stories';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { code: lang.code }, props: { lang } }));
}

interface Props {
  lang: CatalogLanguage;
}
const { lang } = Astro.props;

const uiLocale = hubLocaleFor(lang);
const ui = byCode(uiLocale);
const t = content(uiLocale, 'hub');

const fill = (s: string, vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((acc, [k, v]) => acc.replaceAll(`{${k}}`, String(v)), s);

// The name the reader sees: autonym, or the English name when the autonym is
// unknown (the code never stands as a heading).
const name = displayName(lang);
const showEnglish = lang.englishName && lang.englishName !== name;

// Title pattern from #6: "{Autonym} ({English name}, {code}) | Open Bible Stories".
const nameBits = [showEnglish ? lang.englishName : null, lang.code].filter(Boolean).join(', ');
const title = `${name} (${nameBits}) | Open Bible Stories`;
const langLabel = showEnglish ? `${name} (${lang.englishName})` : name;
const description = fill(t.meta.description, { language: langLabel });

const assets = classifyAssets(lang);
const youtube = youtubeOf(lang);
const pdf = primaryPdf(lang);
const audioZip = audioZipOf(lang);
const videoFile = youtube ? undefined : assets.video.find((a) => /\.(mp4|3gp)$/i.test(a.name));
// The hub lists every story whose title was read. A title links to its own
// page where the build made one, so a link never lands on a page that was not
// built; where NO story has a page, the titles link into the reader instead
// (see read() below).
const stories = readableStories(lang);
// Only link stories whose text is in THIS build. `storyNums` is what a
// previous fetch found and the story files are gitignored, so a build can
// hold a file with fewer stories in it than storyNums claims; asking the
// file itself is what keeps hub links, story routes and the sitemap in step.
const storyRecords = await storiesFor(lang.code);
const paged = new Set(storyRecords.map((s) => s.num));
const firstStory = pagedStories(lang).find((s) => paged.has(s.num))?.num ?? null;
const partial = stories.length > 0 && stories.length < STORY_COUNT;
// What each action can actually deliver.
//
// `lang.formats` comes from the catalog's language-level `attachment_types`,
// which says a format exists SOMEWHERE for this language — not that this site
// can open it. Gating the buttons on it produced two controls that could not
// keep their promise: "Listen (audio)" on 78 of the 92 hubs that showed it
// (69 of them have nothing but a YouTube playlist, which is video), and
// "Read online" on the 14 languages whose repo is a "Video only" placeholder.
// Both resolved to a story page with nothing on it, which is the same defect
// as the legacy "Read online" that pointed at the hub itself.
//
// So each button is gated on the thing it opens. `check:routes` asserts the
// same invariant against the built HTML.
// A media button must point at a story that HAS that medium, not merely at
// the first readable story. A team often records progressively, and
// audioByStory()/videoByStory() key on the two-digit group in a filename, so
// a language can easily have audio on stories 5-50 and none on story 1 —
// which sent "Listen" to a story page with no player. `check:routes` catches
// it, so with the post-build checks in CI this would fail the deploy rather
// than ship, but the page is what has to be right.
const firstStoryWith = (has: (s: (typeof storyRecords)[number]) => unknown) =>
  storyRecords.find((s) => has(s))?.num ?? null;
const audioStory = firstStoryWith((s) => s.audio);
const videoStory = firstStoryWith((s) => s.video);
const hasAudio = audioStory !== null || Boolean(audioZip);
const hasVideo = Boolean(youtube) || Boolean(videoFile) || videoStory !== null;
// How many stories a visitor can actually READ here — the ones the story list
// links, not the titles that were read from the repo. The hub FAQ's first
// answer is built from this, so it cannot promise stories that have no page
// (see the comment on the FAQ section below).
const readable = stories.filter((s) => paged.has(s.num)).length;
// `none` is not "there is nothing here": on a hub whose text could not be
// read at all, the reader still opens (it falls back to the live catalog) and
// the downloads still exist. So the sentence says there are no story PAGES
// and points at what does work.
const storiesSentence = fill(
  readable === 0 ? t.faqStories.none : readable >= STORY_COUNT ? t.faqStories.all : t.faqStories.some,
  { language: name, n: readable, total: STORY_COUNT }
);
const publishers = publishersOf(lang);
const primary = lang.entries[0];
const fontHref = fontHrefForScript(lang.script);
/**
 * Where a "read" control points.
 *
 * A built story page when one exists: a real URL, which is what a crawler
 * follows and what a visitor without JavaScript lands on, and which
 * hub-reader.js intercepts to open the reader in place.
 *
 * A hub can still have no built page for any story: its repo was
 * unreachable, or the fetch step was skipped. Until the legacy
 * translationStudio layout was read in full this was also the permanent state
 * of 18 published languages, and their "Read online" control fell back to the
 * hub's own URL — it reloaded the page and opened nothing, so the one control
 * that should work was the one that could not. The reader itself works there
 * (it falls back to reading the live catalog); it just had no reachable entry
 * point. So a hub with no story pages points at the reader fragments
 * hub-reader.js already handles, `#story-{n}` and `#read`.
 *
 * Deliberately only when NO story has a page. Where some do, a story whose
 * body was not fetched keeps its unlinked title: the reader would be reading
 * this site's own story bundle, which does not contain that story either, so
 * a fragment link there would open the reader on the wrong story rather than
 * on nothing.
 */
const hasPages = firstStory !== null;
const read = (story?: number) => {
  if (hasPages) return storyPath(lang.code, story ?? firstStory!);
  const num = story ?? stories[0]?.num ?? null;
  return num ? `#story-${num}` : '#read';
};
const withSize = (label: string, size: number | null) => (formatSize(size) ? `${label} · ${formatSize(size)}` : label);
// DCS tags already carry a leading "v".
const version = (tag: string) => tag.replace(/^v/i, '');
const pdfsOf = (owner: string) => assets.pdf.filter((a) => a.owner === owner && a.url !== pdf?.url);
// The app is the general OBS app (Play Store ignores hl= for most codes and
// the app does not ship every language), so it is offered as a note, not
// as a per-language format.
const appUrl = 'https://play.google.com/store/apps/details?id=com.unfoldingword.obsapp';
const image = storyImage(1);

/**
 * The chrome strings this page rendered, keyed by the text as it came out.
 *
 * The hub is one URL — there is no /es/l/bho/, because 16 variants of ~9,000
 * story pages would be six figures of files against Cloudflare Pages' 20,000
 * limit — so its chrome is baked in one locale and swapped in the browser for
 * a visitor who prefers another (public/assets/js/locale.js). The swap needs
 * the KEY each rendered string came from and the ARGUMENTS it was filled
 * with, because the preferred locale puts them somewhere else in the
 * sentence: "{n} of {total}" is not word-for-word "{total} में से {n}".
 *
 * Content is deliberately absent: the autonym, the story titles, the story-1
 * extract and its reference are the translation team's work in the content
 * language and stay exactly as built.
 */
type ChromeEntry = {
  k: string;
  /** Arguments the string was filled with. */
  a?: Record<string, string | number>;
  /** Arguments that are themselves chrome strings, by key — the hub FAQ's
   *  first answer embeds one of three `faqStories` sentences. */
  r?: Record<string, string>;
  /** A part that was never translatable and is re-appended: a file size. */
  x?: string;
  /** Drop the optional "(…{size}…)" clause, as the page did. */
  z?: 1;
};
const chrome: Record<string, ChromeEntry> = {};
const mark = (rendered: string, entry: ChromeEntry) => {
  if (rendered) chrome[rendered.trim()] = entry;
};
const label = (key: string, value: string, args?: Record<string, string | number>) =>
  mark(args ? fill(value, args) : value, { k: `hub.${key}`, a: args });

label('allLanguages', t.allLanguages);
label('eyebrow', t.eyebrow, { language: name });
if (stories.length > 0) label('read', t.read);
if (hasAudio) label('audio', t.audio);
if (hasVideo) mark(videoFile ? withSize(t.video, videoFile.size) : t.video, { k: 'hub.video', x: videoFile && formatSize(videoFile.size) ? ` · ${formatSize(videoFile.size)}` : undefined });
if (pdf) mark(withSize(t.pdf, pdf.size), { k: 'hub.pdf', x: formatSize(pdf.size) ? ` · ${formatSize(pdf.size)}` : undefined });
if (audioZip) {
  const size = formatSize(audioZip.size);
  // Without a known size the "(…)" clause is dropped from the label, so the
  // swapped wording has to drop it too — that is what `z` says.
  mark(size ? fill(t.audioZip, { size }) : t.audioZip.replace(/\s*[（(]\{size\}[)）]/, ''), size ? { k: 'hub.audioZip', a: { size } } : { k: 'hub.audioZip', z: 1 });
}
if (!hasPages) label('readerNeedsJs', t.readerNeedsJs);
label('app', t.app);
if (lang.extract) {
  label('extractAlt', t.extractAlt, { language: name, story: lang.extract.title ?? '' });
  label('extractTitle', t.extractTitle);
  label('readStory', t.readStory);
}
label('readerTitle', t.readerTitle);
label('readerLoading', t.readerLoading);
label('readerOffline', t.readerOffline);
if (stories.length > 0) {
  label('storiesTitle', t.storiesTitle, { n: stories.length, total: STORY_COUNT });
  if (partial) {
    label('partial', t.partial, { n: stories.length, total: STORY_COUNT });
    label('partialLink', t.partialLink);
  }
}
label('faqTitle', t.faqTitle, { language: name });
t.faq.forEach((item: { q: string; a: string }, i: number) => {
  mark(fill(item.q, { language: name }), { k: `hub.faq.${i}.q`, a: { language: name } });
  // The story sentence is itself one of three chrome strings, chosen from
  // what this build can render; it goes in by reference so the swap picks the
  // same one in the preferred locale.
  const which = readable === 0 ? 'none' : readable >= STORY_COUNT ? 'all' : 'some';
  mark(fill(item.a, { language: name, stories: storiesSentence }), {
    k: `hub.faq.${i}.a`,
    a: { language: name, n: readable, total: STORY_COUNT },
    r: { stories: `hub.faqStories.${which}` },
  });
});
label('faqMore', t.faqMore);
label('about', t.about);
label('codes', t.codes);
if (lang.altNames.length > 0) label('alsoKnownAs', t.alsoKnownAs);
if (lang.region) label('region', t.region);
label('publisherLabel', t.publisherLabel);
label('license', t.license);
if (publishers.length > 1) label('teams', t.teams, { n: publishers.length });
label('source', t.source);
---

<Base
  locale={uiLocale}
  slug="discover"
  title={title}
  description={description}
  jsonLd={hubNodes(lang, paged)}
  canonicalPath={languagePath(lang.code)}
  htmlLang={lang.code}
  dir={lang.direction}
  alternates={false}
  fontHref={fontHref}
  script={lang.script}
  ogImage={image}
  chrome={chrome}
>

<section class="page-header hub-header" lang={ui.tag} dir={ui.dir} data-i18n-scope="hub">
  <div class="wrap">
    <a class="btn btn-outline hub-back" href={localePath(uiLocale, 'discover')} data-slug="discover"><span aria-hidden="true">&larr;</span> {t.allLanguages}</a>
    <p class="eyebrow">{fill(t.eyebrow, { language: name })}</p>
    <h1 lang={lang.code} dir={lang.direction}>{name}</h1>
    {showEnglish && <p class="hub-english-name">{lang.englishName}</p>}

    <ul class="hub-format-list">
      {/* These point at the first story's own page — a real URL that works
          without JavaScript and that crawlers follow — or, on a hub with no
          story pages at all, at the reader fragment (see read() above).
          hub-reader.js intercepts the click and opens the reader in place. */}
      {stories.length > 0 && <li><a class="btn btn-primary" href={read()}>{t.read}</a></li>}
      {/* Anchored at the player rather than the top of the story page, so
          "Listen" does not land on a page identical to "Read online". */}
      {hasAudio && (
        <li><a class="btn btn-outline" href={audioStory !== null ? `${storyPath(lang.code, audioStory)}#listen` : audioZip!.url}>{t.audio}</a></li>
      )}
      {hasVideo && (
        <li><a class="btn btn-outline" href={youtube?.url ?? videoFile?.url ?? `${storyPath(lang.code, videoStory!)}#watch`} rel="noopener">{videoFile ? withSize(t.video, videoFile.size) : t.video}</a></li>
      )}
      {pdf && (
        <li><a class="btn btn-outline" href={pdf.url} rel="noopener" title={pdf.name}>{withSize(t.pdf, pdf.size)}</a></li>
      )}
      {audioZip && (
        <li><a class="btn btn-outline" href={audioZip.url} rel="noopener" title={audioZip.name}>{formatSize(audioZip.size) ? fill(t.audioZip, { size: formatSize(audioZip.size)! }) : t.audioZip.replace(/\s*[（(]\{size\}[)）]/, '')}</a></li>
      )}
      {assets.epub.slice(0, 1).map((a) => (
        <li><a class="btn btn-outline" href={a.url} rel="noopener" title={a.name}>{withSize('EPUB', a.size)}</a></li>
      ))}
      {assets.docx.slice(0, 1).map((a) => (
        <li><a class="btn btn-outline" href={a.url} rel="noopener" title={a.name}>{withSize('DOCX', a.size)}</a></li>
      ))}
    </ul>
    {/* With no story pages the read controls above are reader fragments,
        which do nothing without JavaScript. Say so, to whoever it applies to,
        and point at what does work — rather than leaving them clicking. */}
    {!hasPages && (
      <noscript>
        <p class="hub-js-note">{t.readerNeedsJs}</p>
      </noscript>
    )}
    <p class="hub-app-note"><a href={appUrl} target="_blank" rel="noopener">{t.app}</a></p>
  </div>
</section>

{lang.extract && (
  <section class="hub-extract" data-i18n-scope="hub">
    <div class="wrap hub-extract-grid">
      {/* Language-appropriate alt (#16): the story-1 illustration, described
          in the hub's own language and naming the language, rather than the
          bare story title (or nothing) that every one of the 214 hubs used
          to share. */}
      <img src={image} alt={fill(t.extractAlt, { language: name, story: lang.extract.title ?? '' })} lang={ui.tag} data-i18n-lang width="360" height="203" loading="lazy" decoding="async" />
      <div>
        <h2 lang={ui.tag} dir={ui.dir} data-i18n-lang>{t.extractTitle}</h2>
        <blockquote lang={lang.code} dir={lang.direction}>
          {lang.extract.title && <p class="hub-extract-title">{lang.extract.title}</p>}
          <p>{lang.extract.text}</p>
          {lang.extract.reference && <footer>{lang.extract.reference}</footer>}
        </blockquote>
        <p lang={ui.tag} dir={ui.dir} data-i18n-lang><a href={read()} class="btn btn-outline">{t.readStory}</a></p>
      </div>
    </div>
  </section>
)}

<!-- The reader. Mounted by /assets/js/reader.js, which reads the live DCS
     catalog for this language, so a newly published release appears here
     without a rebuild. Everything around it — downloads, the story list, the
     story pages — is static and works without JavaScript, so this section
     simply stays collapsed if the script or Door43 is unavailable. -->
{stories.length > 0 && (
<section class="hub-reader" id="read" hidden data-i18n-scope="hub">
  <div class="wrap">
    <h2 lang={ui.tag} dir={ui.dir} data-i18n-lang>{t.readerTitle}</h2>
    <div
      id="hub-reader"
      data-lang={lang.code}
      data-loading={t.readerLoading}
      data-offline={t.readerOffline}
    ></div>
  </div>
</section>
)}

{stories.length > 0 && (
  <section class="hub-stories" data-i18n-scope="hub">
    <div class="wrap">
      <h2 lang={ui.tag} dir={ui.dir} data-i18n-lang>{fill(t.storiesTitle, { n: stories.length, total: STORY_COUNT })}</h2>
      {partial && (
        <p class="hub-partial" lang={ui.tag} dir={ui.dir} data-i18n-lang>
          {fill(t.partial, { n: stories.length, total: STORY_COUNT })}
          <a href={localePath(uiLocale, 'translate')} data-slug="translate">{t.partialLink}</a>
        </p>
      )}
      <ol class="hub-story-list" lang={lang.code} dir={lang.direction}>
        {stories.map((s) => (
          <li>
            {paged.has(s.num) || !hasPages ? (
              /* A story page where one was built; on a hub with no pages at
                 all, the reader fragment instead — see read() above. Both are
                 opened by hub-reader.js. */
              <a href={read(s.num)}>
                <span class="hub-story-num" lang={ui.tag}>{s.num}</span>
                <span class="hub-story-title">{s.title}</span>
              </a>
            ) : (
              /* Title was read but the body was not, on a language where
                 other stories DO have pages — the reader reads this site's
                 own bundle, which is missing this story too, so there is
                 nothing to link to. */
              <span class="hub-story-unlinked">
                <span class="hub-story-num" lang={ui.tag}>{s.num}</span>
                <span class="hub-story-title">{s.title}</span>
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- A short FAQ (#17). Four questions that people and answer engines actually
     ask about a translation: what it is, whether it is the whole Bible, what
     the license lets them do, and how to help finish it. The license answer
     means "may I print this?" is answerable here without opening /license/.
     Visible text only — no FAQPage JSON-LD on 214 near-identical blocks; the
     marketing /faq/ pages carry that.

     LANGUAGE: these answers are in the hub's CHROME language (see
     hubLocaleFor), which is the content language only for the 17 codes the
     site itself is published in, and a regional language of the same script
     for most of the rest. #17 also asks for a 2-3 sentence definition in the
     CONTENT language on every hub; that criterion is not met by this block
     and is deliberately still open — see docs/native-review.md. The
     content-language text on a hub is the H1, the story-1 extract and the
     story titles.

     The first answer's story sentence is chosen from what this build can
     actually render (faqStories.all / .some / .none). It used to promise all
     50 unconditionally, which on /l/awa/ (1 readable) and /l/azb/ (50 titles,
     no readable bodies) told readers and crawlers that missing content was
     there. Note the two are different things: azb IS translated, the text
     just is not readable here, so the "none" wording says exactly that. -->
<section class="hub-faq" lang={ui.tag} dir={ui.dir} data-i18n-scope="hub">
  <div class="wrap">
    <h2>{fill(t.faqTitle, { language: name })}</h2>
    <dl class="faq-list">
      {t.faq.map((item: { q: string; a: string }) => (
        <>
          <dt>{fill(item.q, { language: name })}</dt>
          <dd>{fill(item.a, { language: name, stories: storiesSentence })}</dd>
        </>
      ))}
    </dl>
    <p><a href={localePath(uiLocale, 'faq')} data-slug="faq">{t.faqMore}</a></p>
  </div>
</section>

<section class="hub-about" lang={ui.tag} dir={ui.dir} data-i18n-scope="hub">
  <div class="wrap">
    <h2>{t.about}</h2>
    <dl class="hub-facts">
      <dt>{t.codes}</dt>
      <dd><code>{lang.code}</code></dd>
      {lang.altNames.length > 0 && (
        <>
          <dt>{t.alsoKnownAs}</dt>
          <dd>{lang.altNames.join(', ')}</dd>
        </>
      )}
      {lang.region && (
        <>
          <dt>{t.region}</dt>
          <dd>{lang.region}{lang.countryCodes.length > 0 && <span class="hub-cc"> ({lang.countryCodes.join(', ')})</span>}</dd>
        </>
      )}
      <dt>{t.publisherLabel}</dt>
      <dd>
        <ul class="hub-publishers">
          {lang.entries.map((e) => (
            <li>
              <a href={`https://git.door43.org/${e.owner}/${e.name}`} rel="noopener">{e.owner}</a>
              {e.branch_or_tag_name && <span class="hub-version"> {fill(t.version, { version: version(e.branch_or_tag_name) })}</span>}
              {e.released && <span class="hub-version"> · {e.released}</span>}
              {pdfsOf(e.owner).map((a) => (
                <span class="hub-version"> · <a href={a.url} rel="noopener" title={a.name}>PDF{a.tag ? ` ${a.tag}` : ''}{formatSize(a.size) ? ` (${formatSize(a.size)})` : ''}</a></span>
              ))}
            </li>
          ))}
        </ul>
      </dd>
    </dl>
    <p class="hub-license">
      <strong>unfoldingWord® Open Bible Stories</strong> — {t.license}
      <a href={LICENSE_URL} rel="license noopener">CC BY-SA 4.0</a>.
      {publishers.length > 1 ? fill(t.teams, { n: publishers.length }) : ''}
      {primary && <span> <a href={`https://git.door43.org/${primary.owner}/${primary.name}`} rel="noopener">{t.source}</a></span>}
    </p>
  </div>
</section>

<script is:inline src="/assets/js/reader.js" slot="scripts"></script>
<script is:inline src="/assets/js/hub-reader.js" slot="scripts"></script>

</Base>
