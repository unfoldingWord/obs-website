---
// Language hub: one static page per published OBS translation, generated from
// the build-time catalog snapshot (src/data/catalog.ts). This is the public
// canonical URL for "Open Bible Stories in {language}" (#6): everything a
// crawler or answer engine needs is in the initial HTML — autonym, English
// and alternate names, codes, region, formats that actually exist, the story
// titles that were actually read from the repo (usually all 50), an
// in-language extract of story 1, the publishers, and CC BY-SA attribution.
// The reader itself is still the Discover reader; story pages (Phase 3) will
// replace the deep links here.
//
// The page chrome (nav, footer, labels) uses the marketing locale whose
// primary subtag matches the content language, otherwise English; the
// <html lang>/dir and the font pack follow the CONTENT language.
import Base from '../../../layouts/Base.astro';
import { content } from '../../../i18n/content';
import { byCode, localePath } from '../../../i18n/config';
import {
  languages,
  languagePath,
  readerPath,
  hubLocaleFor,
  fontHrefForScript,
  classifyAssets,
  readableStories,
  publishersOf,
  youtubeOf,
  type CatalogLanguage,
} from '../../../data/catalog';
import { hubNodes, LICENSE_URL } from '../../../lib/jsonld';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { code: lang.code }, props: { lang } }));
}

interface Props {
  lang: CatalogLanguage;
}
const { lang } = Astro.props;

const uiLocale = hubLocaleFor(lang.code);
const ui = byCode(uiLocale);
const t = content(uiLocale, 'hub');

const fill = (s: string, vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((acc, [k, v]) => acc.replaceAll(`{${k}}`, String(v)), s);

// Title pattern from #6: "{Autonym} ({English name}, {code}) | Open Bible Stories".
// When the autonym is unknown the code stands in as the name and is not repeated.
const nameBits = [lang.englishName, lang.title === lang.code ? null : lang.code].filter(Boolean).join(', ');
const title = `${lang.title}${nameBits ? ` (${nameBits})` : ''} | Open Bible Stories`;
const langLabel = lang.englishName ? `${lang.title} (${lang.englishName})` : lang.title;
const description = fill(t.meta.description, { language: langLabel });

const assets = classifyAssets(lang);
const youtube = youtubeOf(lang);
const stories = readableStories(lang);
const publishers = publishersOf(lang);
const primary = lang.entries[0];
const fontHref = fontHrefForScript(lang.script);
const read = (story?: number) => readerPath(lang.code, story, uiLocale);
const fmtSize = (n: number | null) => (n ? `${(n / 1048576).toFixed(n > 10485760 ? 0 : 1)} MB` : null);
// The app is the general OBS app (Play Store ignores hl= for most codes and
// the app does not ship every language), so it is offered as a note, not
// as a per-language format.
const appUrl = 'https://play.google.com/store/apps/details?id=com.unfoldingword.obsapp';
---

<Base
  locale={uiLocale}
  slug="discover"
  title={title}
  description={description}
  jsonLd={hubNodes(lang)}
  canonicalPath={languagePath(lang.code)}
  htmlLang={lang.code}
  dir={lang.direction}
  alternates={false}
  fontHref={fontHref}
  script={lang.script}
>

<section class="page-header hub-header" lang={ui.tag} dir={ui.dir}>
  <div class="wrap">
    <p class="eyebrow"><a href={localePath(uiLocale, 'discover')}>{t.allLanguages}</a> &middot; {fill(t.eyebrow, { language: lang.title })}</p>
    <h1 lang={lang.code} dir={lang.direction}>{lang.title}</h1>
    {lang.englishName && <p class="hub-english-name">{lang.englishName}</p>}
    <dl class="hub-facts">
      <dt>{t.codes}</dt>
      <dd><code>{lang.code}</code></dd>
      {lang.altNames.length > 0 && (
        <>
          <dt>{t.alsoKnownAs}</dt>
          <dd>{lang.altNames.join(', ')}</dd>
        </>
      )}
      {lang.region && (
        <>
          <dt>{t.region}</dt>
          <dd>{lang.region}{lang.countryCodes.length > 0 && <span class="hub-cc"> ({lang.countryCodes.join(', ')})</span>}</dd>
        </>
      )}
      <dt>{t.publisherLabel}</dt>
      <dd>
        {lang.entries.map((e, i) => (
          <span>
            {i > 0 && ', '}
            <a href={`https://git.door43.org/${e.owner}/${e.name}`} rel="noopener">{e.owner}</a>
            {e.branch_or_tag_name && <span class="hub-version"> {fill(t.version, { version: e.branch_or_tag_name })}</span>}
            {e.released && <span class="hub-version"> · {e.released}</span>}
          </span>
        ))}
      </dd>
    </dl>
  </div>
</section>

<section class="hub-formats" lang={ui.tag} dir={ui.dir}>
  <div class="wrap">
    <h2>{t.formatsTitle}</h2>
    <ul class="hub-format-list">
      <li><a class="btn btn-primary" href={read()}>{t.read}</a></li>
      {assets.pdf.slice(0, 3).map((a) => (
        <li><a class="btn btn-outline" href={a.url} rel="noopener">{t.pdf} <span class="hub-asset-meta">{[a.name, fmtSize(a.size), a.tag ? `(${a.tag})` : null].filter(Boolean).join(' ')}</span></a></li>
      ))}
      {assets.epub.slice(0, 1).map((a) => (
        <li><a class="btn btn-outline" href={a.url} rel="noopener">EPUB{fmtSize(a.size) && <span class="hub-asset-meta">{fmtSize(a.size)}</span>}</a></li>
      ))}
      {assets.docx.slice(0, 1).map((a) => (
        <li><a class="btn btn-outline" href={a.url} rel="noopener">DOCX{fmtSize(a.size) && <span class="hub-asset-meta">{fmtSize(a.size)}</span>}</a></li>
      ))}
      {lang.formats.audio && (
        <li><a class="btn btn-outline" href={assets.audio.find((a) => /\.zip$/i.test(a.name))?.url ?? read()} rel="noopener">{t.audio}</a></li>
      )}
      {lang.formats.video && (
        <li><a class="btn btn-outline" href={youtube?.url ?? assets.video[0]?.url ?? read()} rel="noopener">{t.video}</a></li>
      )}
    </ul>
    <p class="hub-app-note"><a href={appUrl} target="_blank" rel="noopener">{t.app}</a></p>
  </div>
</section>

{lang.extract && (
  <section class="hub-extract">
    <div class="wrap">
      <h2 lang={ui.tag} dir={ui.dir}>{t.extractTitle}</h2>
      <blockquote lang={lang.code} dir={lang.direction}>
        {lang.extract.title && <p class="hub-extract-title">{lang.extract.title}</p>}
        <p>{lang.extract.text}</p>
        {lang.extract.reference && <footer>{lang.extract.reference}</footer>}
      </blockquote>
      <p lang={ui.tag} dir={ui.dir}><a href={read(1)} class="btn btn-outline">{t.readStory}</a></p>
    </div>
  </section>
)}

{stories.length > 0 && (
  <section class="hub-stories">
    <div class="wrap">
      <h2 lang={ui.tag} dir={ui.dir}>{fill(t.storiesTitle, { n: stories.length })}</h2>
      <ol class="hub-story-list" lang={lang.code} dir={lang.direction}>
        {stories.map((s) => (
          <li>
            <a href={read(s.num)}>
              <span class="hub-story-num" lang={ui.tag}>{s.num}</span>
              <span class="hub-story-title">{s.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<section class="hub-license" lang={ui.tag} dir={ui.dir}>
  <div class="wrap">
    <p>
      <strong>unfoldingWord® Open Bible Stories</strong> — {t.license}
      <a href={LICENSE_URL} rel="license noopener">CC BY-SA 4.0</a>.
      {publishers.length > 1 ? fill(t.teams, { n: publishers.length }) : ''}
      {primary && <span> <a href={`https://git.door43.org/${primary.owner}/${primary.name}`} rel="noopener">{t.source}</a></span>}
    </p>
  </div>
</section>

</Base>
