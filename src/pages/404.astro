---
import Base from '../layouts/Base.astro';
---
<Base locale="en" slug="404" title="Page not found — Open Bible Stories" description="That page doesn't exist. Find Open Bible Stories in your language on Discover.">

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>That page doesn't exist &mdash; it may have moved or the link may be mistyped. The stories themselves are all on Discover.</p>
    <div class="cta-row" style="margin-top:28px;">
      <a href="/discover/" class="btn btn-primary">Find your language</a>
      <a href="/" class="btn btn-outline">Go to the homepage</a>
    </div>
  </div>
</section>

</Base>
