---
// Shared page shell for every route, locale-aware.
//
// Props:
//   locale      — locale code ('en', 'es', …); English-only pages pass 'en'
//   slug        — page slug (drives nav highlighting, canonical, hreflang,
//                 and the language switcher). English-only slugs (license,
//                 privacy, terms-of-use, 404) get no hreflang alternates and
//                 no language switcher.
//   title, description — per-page <head> values
//   jsonLd      — optional extra JSON-LD nodes merged into the page's single
//                 @graph (Organization + WebSite are always present)
//
// Named slot "scripts" carries per-page script tags after nav.js.
//
// One nav, one order, on every page (the old "resources" variant reordered
// Create/Translate and added a sixth item — a WCAG 3.2.3 Consistent
// Navigation failure; /resources/ was folded into the Translate page's
// Resources tab).
import { locales, byCode, defaultLocale, localePath, fontHrefFor, isLocalized, type PageSlug } from '../i18n/config';
import { content } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { organizationNode, websiteNode, serializeGraph } from '../lib/jsonld';

interface Props {
  locale: string;
  slug: PageSlug;
  title: string;
  description?: string;
  jsonLd?: unknown[];
}

const { locale, slug, title, description, jsonLd = [] } = Astro.props;
const def = byCode(locale);
const ui = content(locale, 'ui');
const localized = isLocalized(slug);

// Canonical/social URLs are absolute; the og:image must be too.
const canonical = new URL(localePath(locale, slug), Astro.site);
const ogImage = new URL('/assets/img/story-boat.jpg', Astro.site);

// The current locale's script font pack, generated by
// scripts/build-font-css.mjs — Latin locales need none.
const fontHref = fontHrefFor(locale);

// One JSON-LD graph per page. Organization + WebSite on every route; pages
// add their own nodes (CreativeWork, ItemList, …) through the jsonLd prop.
const graph = serializeGraph([organizationNode(), websiteNode(def.tag), ...jsonLd]);

// Open Graph locale tags use underscores (es_MX), not BCP-47 hyphens.
const ogLocale = def.tag.replace('-', '_');
---

<html lang={def.tag} dir={def.dir}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={ui.siteTitle} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
{
  localized &&
    locales.map((l) => (
      <link rel="alternate" hreflang={l.tag} href={new URL(localePath(l.code, slug), Astro.site)} />
    ))
}
{localized && <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, slug), Astro.site)} />}
<!-- Fonts are self-hosted (see /assets/fonts/ and the @font-face rules in
     styles.css) rather than loaded from fonts.googleapis.com: no
     render-blocking third-party round trip, and no IP disclosure to a host
     that is slow or blocked in parts of the world this site serves. The
     non-Latin script faces follow the same rule — per-locale stylesheets
     generated by scripts/build-font-css.mjs. -->
<link rel="preload" href="/assets/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/nunito-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
{fontHref && <link href={fontHref} rel="stylesheet" />}
<link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
<link rel="stylesheet" href="/assets/css/styles.css" />
<script type="application/ld+json" set:html={graph} />
<GoogleAnalytics />
<slot name="head" />
</head>
<body>

<a class="skip-link" href="#main">{ui.strings?.skipToContent ?? 'Skip to content'}</a>

<Header locale={locale} ui={ui} slug={slug} />

<main id="main">
<slot />
</main>

<Footer locale={locale} ui={ui} />

<script is:inline src="/assets/js/nav.js"></script>
<slot name="scripts" />

</body>
</html>
