---
// Shared page shell for every route, locale-aware.
//
// Props:
//   locale      — locale code ('en', 'es', …); English-only pages pass 'en'
//   slug        — page slug (drives nav highlighting, canonical, hreflang,
//                 and the language switcher). English-only slugs (license,
//                 privacy, terms-of-use, 404) get no hreflang alternates and
//                 no language switcher.
//   title, description — per-page <head> values
//   jsonLd      — optional extra JSON-LD nodes merged into the page's single
//                 @graph (Organization + WebSite are always present)
//
// Content-language pages (the /l/{code}/ hubs) are not marketing locales:
// they pass the UI locale for the chrome plus these overrides —
//   canonicalPath — the page's own path (self-referencing canonical)
//   htmlLang, dir — the content language, not the UI locale
//   alternates    — false: no hreflang cluster, no og:locale, no switcher
//   fontHref      — script font pack for the content language (or null)
//   script        — the content language's script; emitted as
//                   <html data-script> which styles.css keys the font-family
//                   overrides on (marketing pages take it from their locale)
//   ogImage       — absolute social image URL (default: the story-boat photo)
//   chrome        — chrome strings this page rendered, as
//                   { "<rendered text>": { k: "<dotted key>", a: {args} } }.
//                   Only the single-URL pages (the hubs and story pages) pass
//                   it: they have no locale variants, so a visitor whose
//                   preferred locale differs from the baked one has the
//                   chrome swapped in the browser from /assets/i18n/{code}.json
//                   (see public/assets/js/locale.js). Locale-scoped pages
//                   need none — they are redirected to their own variant.
//
// Named slot "scripts" carries per-page script tags after nav.js.
//
// One nav, one order, on every page (the old "resources" variant reordered
// Create/Translate and added a sixth item — a WCAG 3.2.3 Consistent
// Navigation failure; /resources/ was folded into the Translate page's
// Resources tab).
import { locales, byCode, defaultLocale, localePath, fontHrefFor, isLocalized, localizedSlugs, slugPaths, type PageSlug } from '../i18n/config';
import { content } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { organizationNode, websiteNode, serializeGraph } from '../lib/jsonld';

interface Props {
  locale: string;
  slug: PageSlug;
  title: string;
  description?: string;
  jsonLd?: unknown[];
  canonicalPath?: string;
  htmlLang?: string;
  dir?: 'ltr' | 'rtl';
  alternates?: boolean;
  fontHref?: string | null;
  script?: string;
  ogImage?: string;
  chrome?: Record<string, { k: string; a?: Record<string, string | number> }>;
}

const { locale, slug, title, description, jsonLd = [], canonicalPath, htmlLang, dir, alternates, fontHref: fontOverride, script, ogImage: ogOverride, chrome } = Astro.props;
const def = byCode(locale);
const ui = content(locale, 'ui');
const localized = alternates ?? isLocalized(slug);
const lang = htmlLang ?? def.tag;
const direction = dir ?? def.dir;
const dataScript = script ?? def.script;

// Canonical/social URLs are absolute; the og:image must be too.
const canonical = new URL(canonicalPath ?? localePath(locale, slug), Astro.site);
const ogImage = ogOverride ?? new URL('/assets/img/story-boat.jpg', Astro.site);

// The current locale's script font pack, generated by
// scripts/build-font-css.mjs — Latin locales need none.
const fontHref = fontOverride !== undefined ? fontOverride : fontHrefFor(locale);

// One JSON-LD graph per page. Organization + WebSite on every route; pages
// add their own nodes (CreativeWork, ItemList, …) through the jsonLd prop.
const graph = serializeGraph([organizationNode(), websiteNode(lang), ...jsonLd]);

// Open Graph locale tags use underscores (es_MX), not BCP-47 hyphens. Only
// marketing locales have a meaningful og:locale cluster.
const ogLocale = def.tag.replace('-', '_');

// The header, footer and skip link are rendered here, so their strings are
// registered here too — the page's own `chrome` prop covers only what the
// page itself renders. Without this a swapped hub kept an untranslated nav.
const chromeAll = chrome
  ? {
      ...Object.fromEntries(
        [
          ['ui.siteTitle', ui.siteTitle],
          ['ui.strings.skipToContent', ui.strings?.skipToContent],
          ['ui.strings.menuLabel', ui.strings?.menuLabel],
          ['ui.strings.languageLabel', ui.strings?.languageLabel],
          ['ui.strings.faqLabel', ui.strings?.faqLabel],
          ['ui.legal.license', ui.legal?.license],
          ['ui.legal.privacy', ui.legal?.privacy],
          ['ui.legal.terms', ui.legal?.terms],
          ...ui.nav.map((item: { label: string }, i: number) => [`ui.nav.${i}.label`, item.label]),
        ]
          .filter(([, v]) => typeof v === 'string' && v)
          .map(([k, v]) => [String(v).trim(), { k }])
      ),
      ...chrome,
    }
  : undefined;

// What public/assets/js/locale.js needs to resolve the visitor's preferred
// interface language: the locales this site is published in, their BCP-47
// tags (to match against navigator.languages), this page's own locale, and
// whether this page has locale variants to redirect to.
const localeMeta = JSON.stringify({
  locale,
  defaultLocale,
  alternates: localized,
  locales: locales.map((l) => l.code),
  tags: Object.fromEntries(locales.map((l) => [l.code, l.tag])),
  // Needed to put nav and footer hrefs back when a visitor picks the locale
  // the page was built in.
  slugs: Object.fromEntries(localizedSlugs.map((sl) => [sl, slugPaths[sl]])),
});
---

<html lang={lang} dir={direction} data-script={dataScript}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={ui.siteTitle} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
{localized && <meta property="og:locale" content={ogLocale} />}
{
  localized &&
    locales
      .filter((l) => l.code !== locale)
      .map((l) => <meta property="og:locale:alternate" content={l.tag.replace('-', '_')} />)
}
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
{
  localized &&
    locales.map((l) => (
      <link rel="alternate" hreflang={l.tag} href={new URL(localePath(l.code, slug), Astro.site)} />
    ))
}
{localized && <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLocale, slug), Astro.site)} />}
<!-- Fonts are self-hosted (see /assets/fonts/ and the @font-face rules in
     styles.css) rather than loaded from fonts.googleapis.com: no
     render-blocking third-party round trip, and no IP disclosure to a host
     that is slow or blocked in parts of the world this site serves. The
     non-Latin script faces follow the same rule — per-locale stylesheets
     generated by scripts/build-font-css.mjs. -->
<link rel="preload" href="/assets/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/nunito-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
{fontHref && <link href={fontHref} rel="stylesheet" />}
<link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
<link rel="stylesheet" href="/assets/css/styles.css" />
<script type="application/ld+json" set:html={graph} />
<!-- The interface-language preference (public/assets/js/locale.js). In <head>
     and not deferred: a visitor whose language has its own copy of this page
     is redirected there, and that must happen before the browser paints a
     page they are about to leave. The chrome swap in the same script waits
     for the DOM. -->
<script is:inline set:html={`window.__obsLocale=${localeMeta}`} />
<script is:inline src="/assets/js/locale.js"></script>
<GoogleAnalytics />
<slot name="head" />
</head>
<body>

<a class="skip-link" href="#main">{ui.strings?.skipToContent ?? 'Skip to content'}</a>

{/* The switcher belongs on the single-URL pages too, and especially there:
    they are the ~9,200 pages where the interface language is inferred rather
    than chosen, so they were the only pages offering no way to correct it.
    On those pages a pick applies in place (locale.js) instead of navigating;
    the href stays as the no-JavaScript fallback. */}
<Header locale={locale} ui={ui} slug={slug} switcher={localized || Boolean(chromeAll)} />

<main id="main">
<slot />
</main>

<Footer locale={locale} ui={ui} />

{chromeAll && <script type="application/json" id="obs-chrome" set:html={JSON.stringify({ keys: chromeAll })} />}
<script is:inline src="/assets/js/nav.js"></script>
<slot name="scripts" />

</body>
</html>
