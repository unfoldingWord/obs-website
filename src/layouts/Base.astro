---
// Shared page shell for every route.
//
// Props:
//   title, description — per-page <head> values
//   active             — slug of the nav link that gets aria-current="page"
//
// Named slot "scripts" carries per-page script tags after nav.js.
//
// One nav, one order, on every page (the old "resources" variant reordered
// Create/Translate and added a sixth item, so the navigation rearranged
// under the visitor mid-session — a WCAG 3.2.3 Consistent Navigation
// failure; /resources/ itself was folded into the Translate page's
// Resources tab).
const { title, description, active = null } = Astro.props;
const cur = (slug) => (active === slug ? 'page' : null);

// Canonical/social URLs are absolute; the og:image must be too.
const SITE = 'https://openbiblestories.org';
const canonical = SITE + Astro.url.pathname;
const ogImage = SITE + '/assets/img/story-boat.jpg';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Open Bible Stories">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<!-- Fonts are self-hosted (see /assets/fonts/ and the @font-face rules in
     styles.css) rather than loaded from fonts.googleapis.com: no
     render-blocking third-party round trip, and no IP disclosure to a host
     that is slow or blocked in parts of the world this site serves. -->
<link rel="preload" href="/assets/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/nunito-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
<link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-nav">
  <div class="nav-inner">
    <a class="brand" href="/">Open Bible Stories</a>
    <nav class="links" id="nav-links">
        <a href="/why-obs/" aria-current={cur('why-obs')}>Why OBS</a>
        <a href="/discover/" aria-current={cur('discover')}>Discover</a>
        <a href="/translate/" aria-current={cur('translate')}>Translate</a>
        <a href="/create/" aria-current={cur('create')}>Create</a>
        <a href="/contact/" aria-current={cur('contact')}>Contact</a>
    </nav>
    <button class="menu-btn" aria-label="Open menu" aria-expanded="false">&#9776;</button>
  </div>
</header>

<main id="main">
<slot />
</main>

<footer>
  <div class="wrap">
    <div class="footer-top">
      <a href="https://unfoldingword.org"><img src="/assets/img/uw-logo-color.png" alt="unfoldingWord" width="160" height="28"></a>
      <div class="footer-links">
          <a href="/why-obs/">Why OBS</a>
          <a href="/discover/">Discover</a>
          <a href="/translate/">Translate</a>
          <a href="/create/">Create</a>
          <a href="/contact/">Contact</a>
      </div>
    </div>
    <p class="footer-credit">unfoldingWord&reg; Open Bible Stories is developed by <a href="https://unfoldingword.org">unfoldingWord&reg;</a> and the <a href="https://door43.org/">Door43 World Missions Community</a>. Free to use, adapt, and share under <a href="https://creativecommons.org/licenses/by-sa/4.0">CC BY-SA 4.0</a>. Original illustrations are &copy; <a href="https://www.sweetpublishing.com/">Sweet Publishing</a>.</p>
    <p class="footer-legal"><a href="/license/">License</a> &middot; <a href="/privacy/">Privacy Policy</a> &middot; <a href="/terms-of-use/">Terms of Use</a></p>
  </div>
</footer>

<script is:inline src="/assets/js/nav.js"></script>
<slot name="scripts" />

</body>
</html>
