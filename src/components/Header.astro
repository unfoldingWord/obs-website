---
import { localePath, isLocalized, type PageSlug } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  ui: any;
  slug: PageSlug;
  /** Show the locale switcher (defaults to: the page has locale variants). */
  switcher?: boolean;
}
const { locale, ui, slug, switcher } = Astro.props;
const showSwitcher = switcher ?? isLocalized(slug);
---

<header class="site-nav" data-i18n-scope="header">
  <div class="nav-inner">
    <a class="brand" href={localePath(locale, 'home')} data-slug="home">{ui.siteTitle}</a>
    <nav class="links" id="nav-links">
      {
        ui.nav.map((item: { label: string; slug: PageSlug }) => (
          <a
            href={localePath(locale, item.slug)}
            data-slug={item.slug}
            aria-current={item.slug === slug ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {showSwitcher && (
      <LanguageSwitcher locale={locale} slug={slug} label={ui.strings?.languageLabel ?? 'Language'} />
    )}
    <button class="menu-btn" aria-label={ui.strings?.menuLabel ?? 'Open menu'} aria-expanded="false">&#9776;</button>
  </div>
</header>
