---
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { defaultLocale, localePath, byCode } from '../../i18n/config';
import { languages, languageCount, withCount, languagePath, type CatalogLanguage } from '../../data/catalog';
import { continentOf, regionCode, type ContinentCode } from '../../data/continents';
import { workNode, translationListNode } from '../../lib/jsonld';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'discover');

// The full language list is prerendered from the build-time catalog snapshot
// (src/data/catalog.ts) so crawlers and no-JS visitors see every published
// language. discover.js then enhances the same rows: search and format
// filters hide/show them, and clicking a row opens the inline reader.
//
// Each row links to the language's hub (/l/{code}/), a real crawlable page.
// With JS, discover.js intercepts the click to open the inline reader and
// keeps the open language in the URL hash; the <li id={code}> makes hash
// deep links scroll to the row even without JS.
const title = withCount(t.meta.title);
const description = withCount(t.meta.description);
// Print-only facts per row (see `.print-meta` in styles.css): where a
// language is used and when it was last updated. They are left off the
// screen layout on purpose — the row stays a compact search result — but a
// printed list is read away from the site, without the hub one click away.
// Names and dates are formatted for the page's locale at build time.
const localeTag = byCode(locale).tag;
const regionNames = new Intl.DisplayNames([localeTag, 'en'], { type: 'region' });
const listFormat = new Intl.ListFormat(localeTag, { type: 'conjunction' });
const dateFormat = new Intl.DateTimeFormat(localeTag, { dateStyle: 'medium', timeZone: 'UTC' });
/** Up to this many countries are printed by name; beyond it, continents. */
const MAX_COUNTRIES = 6;
function nameOf(code: string): string {
  try {
    return regionNames.of(code) ?? code;
  } catch {
    return code;
  }
}
/**
 * Where a language is used, for the printed list. A language listed in a
 * handful of countries prints them by name. A widely spoken one prints
 * continents instead: the catalog's own region first, then any other
 * continent at least two of its countries are in. The country list is a
 * capped sample that includes diaspora communities (French lists French
 * Guiana and Israel), so a single country is not enough to name a
 * continent — French reads "Europe and Africa", not every continent.
 */
function whereUsed(l: CatalogLanguage): string | null {
  const ccs = l.countryCodes ?? [];
  const primary = regionCode(l.region);
  if (ccs.length > 0 && ccs.length <= MAX_COUNTRIES) return listFormat.format(ccs.map(nameOf));
  if (ccs.length > MAX_COUNTRIES) {
    const counts = new Map<ContinentCode, number>();
    for (const cc of ccs) {
      const c = continentOf(cc);
      if (c) counts.set(c, (counts.get(c) ?? 0) + 1);
    }
    const others = [...counts]
      .filter(([c, n]) => c !== primary && n >= 2)
      .sort((a, b) => b[1] - a[1])
      .map(([c]) => c);
    const continents = primary ? [primary, ...others] : others;
    if (continents.length) return listFormat.format(continents.map(nameOf));
  }
  return primary ? nameOf(primary) : l.region;
}
function formatDate(iso: string | null): string | null {
  if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return null;
  return dateFormat.format(new Date(`${iso}T00:00:00Z`));
}
const status = t.browse.status.replace('{shown}', String(languageCount)).replace('{total}', String(languageCount));

// The ItemList of translations is emitted once, on the canonical (English)
// catalog page, not repeated on all 16 locale copies.
const jsonLd = locale === defaultLocale ? [workNode(), translationListNode(languages)] : [workNode()];
---

<Base locale={locale} slug="discover" title={title} description={description} jsonLd={jsonLd}>

<section class="page-header" style="padding:44px 0 32px;">
  <div class="wrap">
    <div class="discover-hero-intro">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 style="margin:8px 0 14px;">{t.hero.title}</h1>
      <p style="max-width:520px;">{withCount(t.hero.sub)}</p>

      <a href="https://play.google.com/store/apps/details?id=com.unfoldingword.obsapp&hl=en_US" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top:20px;">{t.hero.ctaApp}</a>

      <!-- Placed last in the DOM on purpose: position:absolute on desktop,
           flows below the intro text on mobile. -->
      <img src="/assets/img/world-map-backdrop.svg" alt="" aria-hidden="true" class="discover-map-backdrop" />
    </div>

    <div
      id="lang-browse"
      style="margin-top:60px;"
      data-status={t.browse.status}
      data-no-match={t.browse.noMatch}
      data-no-match-format={t.browse.noMatchFormat}
    >
      <div class="library-tools">
        <div class="search-box">
          <span aria-hidden="true">&#128269;</span>
          <input id="lang-search" type="search" name="q" placeholder={t.browse.searchPlaceholder} aria-label={t.browse.searchPlaceholder} />
        </div>
        <div class="format-filters">
          <button type="button" class="filter-chip active" data-format="all" aria-pressed="true">{t.browse.filterAll}</button>
          <button type="button" class="filter-chip" data-format="pdf" aria-pressed="false">{t.browse.filterPrint}</button>
          <button type="button" class="filter-chip" data-format="audio" aria-pressed="false">{t.browse.filterAudio}</button>
          <button type="button" class="filter-chip" data-format="video" aria-pressed="false">{t.browse.filterVideo}</button>
        </div>
      </div>
      <p id="lib-status" class="lib-status" aria-live="polite">{status}</p>
      <ul id="lang-list" class="lang-list">
        {
          languages.map((l) => (
            <li id={l.code}>
              <a
                class="lang-row"
                href={languagePath(l.code)}
                data-lang={l.code}
                data-title={l.title}
                data-search={[l.title, l.englishName, ...l.altNames, l.code].filter(Boolean).join(' ')}
                data-pdf={l.formats.pdf ? '1' : undefined}
                data-audio={l.formats.audio ? '1' : undefined}
                data-video={l.formats.video ? '1' : undefined}
              >
                <div>
                  <div class="name" lang={l.code} dir={l.direction}>{l.title}</div>
                  <div class="code">
                    {l.englishName && l.englishName !== l.title && <span class="english">{l.englishName} &middot; </span>}
                    <code>{l.code}</code>
                    {l.entries.length > 1 && <span> &middot; {t.browse.teams.replace('{n}', String(l.entries.length))}</span>}
                  </div>
                  {(() => {
                    const where = whereUsed(l);
                    const updated = formatDate(l.updated);
                    if (!where && !updated) return null;
                    return (
                      <div class="print-meta">
                        {where && <span>{t.browse.print.countries} {where}</span>}
                        {updated && <span>{t.browse.print.updated} {updated}</span>}
                      </div>
                    );
                  })()}
                </div>
                <div class="badges">
                  {l.formats.pdf && <span class="badge">{t.browse.filterPrint}</span>}
                  {l.formats.audio && <span class="badge audio">{t.browse.filterAudio}</span>}
                  {l.formats.video && <span class="badge video">{t.browse.filterVideo}</span>}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline src="/assets/js/discover.js" slot="scripts"></script>

</Base>
