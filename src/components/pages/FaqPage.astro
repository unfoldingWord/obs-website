---
// Localized questions and answers (#17).
//
// Generative engines quote short, direct answers to real questions, and they
// quote them in the language of the question. The rest of the site is
// marketing prose; this page is the one place where "is Open Bible Stories a
// Bible translation?", "may I print it?" and "which story is Easter?" are
// answered in two or three sentences, in each of the 16 locales, in the
// initial HTML.
//
// Shape follows the guidance in #17: the question is an H2, the answer opens
// with the answer itself and only then adds detail. FAQPage JSON-LD is
// emitted here — on the marketing locales, where the visible text and the
// structured data are the same words. The language hubs carry their own
// short FAQ (hub.json → faq) without schema, because 214 near-identical
// FAQPage nodes would be exactly the boilerplate Google's guidelines warn
// about.
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { withCount } from '../../data/catalog';
import { faqPageNode } from '../../lib/jsonld';
import { localizeLinks, defaultLocale } from '../../i18n/config';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'faq');

// `{count}` is the published-language count; in-copy links stay inside the
// current locale (localizeLinks leaves /license/ and other English-only
// pages at the root).
const prose = (s: string) => localizeLinks(withCount(s), locale);
const questions: { q: string; a: string }[] = t.questions.map((item: { q: string; a: string }) => ({
  q: withCount(item.q),
  a: prose(item.a),
}));

// An answer may run to more than one paragraph: a blank line in the string
// separates them. The first paragraph is always the answer itself, so a
// reader — or a model quoting the page — gets it without the detail that
// follows. Schema.org Answer.text is a single string, so faqPageNode keeps
// the whole answer with the break flattened to a space.
const paragraphsOf = (a: string) => a.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const flat = questions.map(({ q, a }) => ({ q, a: paragraphsOf(a).join(' ') }));

// A stable anchor per question, so a single answer can be linked, shared or
// cited — which is most of what people do with an FAQ, and what a generative
// engine cites when it quotes a passage. The slug comes from the ENGLISH
// question, not the translated text, so `/es/faq/#can-i-copy` and
// `/faq/#can-i-copy` are the same anchor and a retranslation cannot break an
// inbound link.
const english = content(defaultLocale, 'faq');
const slugs: string[] = english.questions.map((item: { q: string }) =>
  item.q
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .split(/\s+/)
    .slice(0, 4)
    .join('-')
);
---

<Base
  locale={locale}
  slug="faq"
  title={t.meta.title}
  description={withCount(t.meta.description)}
  jsonLd={[faqPageNode(locale, flat)]}
>

<section class="page-header">
  <div class="wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="page-header-sub" set:html={prose(t.intro)} />
  </div>
</section>

<section>
  <div class="wrap faq-list">
    {/* A jump list: at phone width the two long answers otherwise push the
        later questions a long way down. */}
    <nav class="faq-jump" aria-labelledby="faq-jump-label">
      <p id="faq-jump-label" class="sr-only">{t.title}</p>
      <ul>
        {questions.map(({ q }, i) => (
          <li><a href={`#${slugs[i]}`}>{q}</a></li>
        ))}
      </ul>
    </nav>
    {questions.map(({ q, a }, i) => (
      <div class="faq-item">
        <h2 id={slugs[i]}>{q}</h2>
        {paragraphsOf(a).map((para) => <p set:html={para} />)}
      </div>
    ))}
  </div>
</section>

</Base>
