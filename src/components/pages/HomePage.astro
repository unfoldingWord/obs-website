---
import Base from '../../layouts/Base.astro';
import { localePath, byCode, localizeLinks } from '../../i18n/config';
import { content } from '../../i18n/content';
import { languageCount, latestRelease, withCount } from '../../data/catalog';
import { workNode, homePageNode, mobileAppNode, faqPageNode } from '../../lib/jsonld';
import { CHANGELOG_PATH } from '../../lib/changelog';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'home');
const ui = content(locale, 'ui');

// Title carries the localized tagline so each locale's home is distinct
// ("Open Bible Stories — El Evangelio para cada pueblo"); the description
// gets the build-time language count substituted for {count}.
const title = `${ui.siteTitle} — ${t.hero.title}`;
const description = withCount(t.meta.description);

// When the catalog behind the count last changed, shown beside the link to
// the changelog and stated as the page's dateModified — the same date in
// both places. A bare ISO date is a calendar day, so format it in UTC.
const updatedLabel = latestRelease
  ? new Intl.DateTimeFormat(byCode(locale).tag, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${latestRelease}T00:00:00Z`))
  : null;
const imageAlts: string[] = t.hero.imageAlts ?? [];

// Quick answers: the first four questions from the contact page's FAQ, each
// with only its first paragraph — the answer itself, which the FAQ copy
// always puts first — and a link to the full set. Not a second copy of the
// FAQ: the detail, and the remaining questions, stay on the contact page.
const faq = content(locale, 'faq');
const hub = content(locale, 'hub');
const QUICK_ANSWERS = 4;
const quickAnswers: { q: string; a: string }[] = faq.questions.slice(0, QUICK_ANSWERS).map((item: { q: string; a: string }) => ({
  q: withCount(item.q),
  a: localizeLinks(withCount(item.a.split(/\n\s*\n/)[0].trim()), locale),
}));
---

<Base locale={locale} slug="home" title={title} description={description} jsonLd={[
  homePageNode(byCode(locale).tag, localePath(locale, 'home'), title, description, latestRelease),
  workNode(),
  mobileAppNode(),
  faqPageNode(locale, quickAnswers, localePath(locale, 'home')),
]}>

<section class="hero">
  <div class="hero-inner">
    <div>
      <p class="eyebrow" set:html={t.hero.eyebrow} />
      <h1>{t.hero.title}</h1>
      <p class="sub">{t.hero.sub}</p>
      <div class="cta-row">
        <a href={localePath(locale, 'discover')} class="btn btn-primary">{t.hero.ctaFind}</a>
        <a href={localePath(locale, 'translate')} class="btn btn-outline">{t.hero.ctaTranslate}</a>
        <!-- MOBILE APP: third CTA in the row, rather than a separate section
             further down the page, so it's seen without scrolling. -->
        <a href="https://play.google.com/store/apps/details?id=com.unfoldingword.obsapp&hl=en_US" target="_blank" rel="noopener" class="btn btn-outline">{t.hero.ctaApp}</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-stack" id="hero-stack">
        <img src="/assets/img/story-boat.jpg" alt={imageAlts[0] ?? ''} width="1000" height="573" class="stack-pos-0" />
        <img src="/assets/img/story-garden.jpg" alt={imageAlts[1] ?? ''} width="1000" height="565" class="stack-pos-1" />
        <img src="/assets/img/story-crowd.jpg" alt={imageAlts[2] ?? ''} width="1000" height="567" class="stack-pos-2" />
        <img src="/assets/img/story-mountain.jpg" alt={imageAlts[3] ?? ''} width="1000" height="562" class="stack-pos-3" />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const stack = document.getElementById("hero-stack");
    if (!stack) return;
    const images = Array.from(stack.querySelectorAll("img"));
    const classes = ["stack-pos-0", "stack-pos-1", "stack-pos-2", "stack-pos-3"];

    function cycle() {
      images.forEach((img) => {
        const current = classes.findIndex((c) => img.classList.contains(c));
        const next = (current + 1) % classes.length;
        img.classList.remove(classes[current]);
        img.classList.add(classes[next]);
      });
    }

    stack.addEventListener("mouseenter", cycle);
    stack.addEventListener("click", cycle);
  })();
</script>

<section class="stats-section">
  <div class="wrap stats-inner" style="text-align:center;">
    <div class="big-stat">
      <span class="big-stat-num" id="lang-count" data-target={languageCount}>{languageCount}</span>
      <span class="big-stat-label" set:html={t.stats.label} />
    </div>
    <p style="color:var(--tech); font-size:1.15rem; max-width:560px; margin:28px auto 10px; font-weight:600;">{t.stats.line1}</p>
    <p style="color:var(--kindle-text); font-size:1.2rem; font-weight:800; margin:0;">{t.stats.line2}</p>
    {updatedLabel && (
      <p style="color:var(--tech); font-size:0.95rem; margin:18px 0 0;">
        <a href={CHANGELOG_PATH}>{ui.legal?.changelog ?? 'What’s new'}</a> &middot; <time datetime={latestRelease}>{updatedLabel}</time>
      </p>
    )}
  </div>
</section>

<section id="story">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.open.eyebrow}</p>
      <h2>{t.open.title}</h2>
      <p set:html={t.open.body} />
    </div>

    <div class="card-grid">
      <div class="card">
        <h3>{t.open.cards[0].title}</h3>
        <p>{t.open.cards[0].body}</p>
        <a href={localePath(locale, 'discover')} class="btn btn-outline" style="margin-top:14px;">{t.open.cards[0].cta}</a>
      </div>
      <div class="card">
        <h3>{t.open.cards[1].title}</h3>
        <p>{t.open.cards[1].body}</p>
        <a href={localePath(locale, 'translate')} class="btn btn-outline" style="margin-top:14px;">{t.open.cards[1].cta}</a>
      </div>
      <div class="card">
        <h3>{t.open.cards[2].title}</h3>
        <p>{t.open.cards[2].body}</p>
        <a href={localePath(locale, 'create')} class="btn btn-outline" style="margin-top:14px;">{t.open.cards[2].cta}</a>
      </div>
    </div>
  </div>
</section>

<section id="faq">
  <div class="wrap faq-list">
    <h2 class="contact-faq-title">{faq.title}</h2>
    {quickAnswers.map(({ q, a }) => (
      <div class="faq-item">
        <h3>{q}</h3>
        <p set:html={a} />
      </div>
    ))}
    <p style="margin-top:32px;"><a href={localePath(locale, 'contact')}>{hub.faqMore}</a></p>
  </div>
</section>

<section class="final-cta" id="cta">
  <div class="wrap final-cta-inner">
    <h2>{t.finalCta.title}</h2>
    <p>{t.finalCta.body}</p>
    <div class="cta-row">
      <a href={localePath(locale, 'translate')} class="btn btn-primary">{t.finalCta.ctaTranslate}</a>
      <a href="https://unfoldingword.org/give/" target="_blank" rel="noopener" class="btn btn-outline">{t.finalCta.ctaGive}</a>
    </div>
  </div>
</section>

<Fragment slot="scripts">
<script is:inline src="/assets/js/lang-count.js"></script>
</Fragment>

</Base>
