---
// Google Analytics 4 (gtag.js).
//
// Rendered from Base.astro's <head>, so it loads on every page in every
// locale. Two rules keep it honest:
//
//   1. is:inline + set:html — the tags must reach the browser verbatim.
//      Without is:inline Astro would bundle/hoist the module; without
//      set:html (i.e. using define:vars) Astro wraps the body in an IIFE,
//      which would hide the `gtag()` global the snippet is supposed to
//      define. `window.gtag` is assigned explicitly for the same reason.
//   2. Production only — `astro dev` and `astro preview` runs would
//      otherwise pollute the property with local traffic. Set
//      PUBLIC_GA_DEBUG=1 to load it anyway when testing the tag itself.
//
// The measurement ID is a public identifier (it ships in the page source),
// so it lives in the repo; PUBLIC_GA_MEASUREMENT_ID overrides it if the
// property ever changes or a staging property is wanted.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-807SQFXMBE';
const enabled = Boolean(measurementId) && (import.meta.env.PROD || import.meta.env.PUBLIC_GA_DEBUG === '1');
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
      <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', '${measurementId}');`} />
    </>
  )
}
