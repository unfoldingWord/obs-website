{
  "name": "obs-website",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-font-css.mjs && node scripts/fetch-catalog.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-font-css.mjs && node scripts/fetch-catalog.mjs --required",
    "build": "astro build",
    "preview": "astro preview",
    "check:locales": "node scripts/check-locales.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "baseline": "node scripts/geo-baseline.mjs",
    "review": "node scripts/review-strings.mjs",
    "fetch:catalog": "node scripts/fetch-catalog.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:routes": "node scripts/check-routes.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.2.0",
